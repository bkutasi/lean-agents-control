{
  "name": "@nextsystems/lac-lean",
  "version": "0.8.0",
  "description": "Lean OpenCode agent pack: OpenAgent + 10 subagents, lean-ctx-native. OpenCode-only.",
  "files": [
    ".opencode/agent/",
    ".opencode/command/",
    ".opencode/skills/",
    ".opencode/opencode.json",
    "AGENTS.md",
    ".lean-ctx.toml",
    "knowledge/",
    "install.sh",
    "VERSION",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "cd evals/framework && npm run eval:sdk:core -- --agent=openagent",
    "test:smoke": "cd evals/framework && npm run eval:sdk -- --agent=openagent --pattern='**/golden/00-smoke-test.yaml' --no-evaluators",
    "test:lean": "cd evals/framework && npm run validate:suites:all",
    "doctor": "lean-ctx doctor && lean-ctx rules status",
    "savings": "lean-ctx savings && lean-ctx gain --deep"
  },
  "keywords": [
    "opencode",
    "lean-ctx",
    "ai-agents",
    "plan-first"
  ],
  "license": "MIT"
}
