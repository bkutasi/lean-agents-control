{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {"action": "read", "resource": "*", "effect": "deny"},
    {"action": "glob", "resource": "*", "effect": "deny"},
    {"action": "grep", "resource": "*", "effect": "deny"},
    {"action": "edit", "resource": "*", "effect": "deny"},
    {"action": "skill", "resource": "*", "effect": "allow"},
    {"action": "subagent", "resource": "*", "effect": "allow"},
    {"action": "question", "resource": "*", "effect": "allow"},
    {"action": "webfetch", "resource": "*", "effect": "allow"},
    {"action": "websearch", "resource": "*", "effect": "allow"},
    {"action": "shell", "resource": "lean-ctx *", "effect": "allow"},
    {"action": "shell", "resource": "git status *", "effect": "allow"},
    {"action": "shell", "resource": "git diff *", "effect": "allow"},
    {"action": "shell", "resource": "git log *", "effect": "allow"},
    {"action": "shell", "resource": "ls *", "effect": "allow"},
    {"action": "shell", "resource": "npm run test:lean *", "effect": "allow"},
    {"action": "shell", "resource": "npm run test:smoke *", "effect": "allow"},
    {"action": "shell", "resource": "npx vitest *", "effect": "allow"},
    {"action": "shell", "resource": "python3 *", "effect": "allow"},
    {"action": "shell", "resource": "pytest *", "effect": "allow"},
    {"action": "shell", "resource": "npx tsc *", "effect": "allow"},
    {"action": "shell", "resource": "go test *", "effect": "allow"},
    {"action": "shell", "resource": "cargo test *", "effect": "allow"},
    {"action": "shell", "resource": "cargo check *", "effect": "allow"},
    {"action": "shell", "resource": "npm run build *", "effect": "allow"},
    {"action": "read", "resource": "**/*.env*", "effect": "deny"},
    {"action": "read", "resource": "**/*.key", "effect": "deny"},
    {"action": "read", "resource": "**/*.secret", "effect": "deny"},
    {"action": "read", "resource": ".git/*", "effect": "deny"},
    {"action": "edit", "resource": "**/*.env*", "effect": "deny"},
    {"action": "edit", "resource": "**/*.key", "effect": "deny"},
    {"action": "edit", "resource": "**/*.secret", "effect": "deny"},
    {"action": "edit", "resource": ".git/*", "effect": "deny"},
    {"action": "shell", "resource": "rm -rf *", "effect": "deny"},
    {"action": "shell", "resource": "sudo *", "effect": "deny"},
    {"action": "shell", "resource": "su *", "effect": "deny"},
    {"action": "shell", "resource": "chmod -R *", "effect": "deny"},
    {"action": "shell", "resource": "chown *", "effect": "deny"},
    {"action": "shell", "resource": "mkfs*", "effect": "deny"},
    {"action": "shell", "resource": "dd *", "effect": "deny"},
    {"action": "shell", "resource": "shutdown *", "effect": "deny"},
    {"action": "shell", "resource": "reboot *", "effect": "deny"}
  ],
  "plugin": ["file:///home/bkutasi/.config/opencode/plugins/githubrepo-v2"],
  "skills": ["./.opencode/skills/lean-ctx", "./.opencode/skills/context7"],
  "agents": {
    "OpenAgent": { "mode": "primary", "description": "Sole primary orchestrator, lean-ctx-native plan-first execution" },
    "ContextScout": { "mode": "subagent", "description": "Local pattern discovery via ctx_overview/ctx_compose, read-only" },
    "ExternalScout": { "mode": "subagent", "description": "Live versioned docs via ctx_url_read and Context7" },
    "TaskManager": { "mode": "subagent", "description": "Breaks hard tasks into atomic parallel batches" },
    "CoderAgent": { "mode": "subagent", "description": "Implements subtasks via ctx_read(paths[]) anchored + ctx_patch" },
    "TestEngineer": { "mode": "subagent", "description": "AAA tests, positive+negative, mocked externals" },
    "BuildAgent": { "mode": "subagent", "description": "Typecheck and build validation, report-only" },
    "CodeReviewer": { "mode": "subagent", "description": "Security-first review, read-only with impact analysis" },
    "DocWriter": { "mode": "subagent", "description": "Concise example-driven markdown docs" },
    "OpenFrontendSpecialist": { "mode": "subagent", "description": "4-stage UI design with per-stage approval" },
    "OpenDevopsSpecialist": { "mode": "subagent", "description": "CI/CD and IaC, least privilege" }
  }
}
